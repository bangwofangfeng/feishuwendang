# 飞书自建应用凭证（开放平台 → 开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书开放平台域名；Lark 国际版填 https://open.larksuite.com
# FEISHU_BASE_URL=https://open.feishu.cn

# 服务端口（只监听 127.0.0.1）
PORT=3001

# 定时同步间隔（分钟）；0 表示关闭定时同步，只保留手动同步
SYNC_INTERVAL_MINUTES=15

# AI 助手：DeepSeek + 飞书官方 MCP Server
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 使用第三方网关或自建兼容服务时填写
# DEEPSEEK_BASE_URL=https://api.deepseek.com
MCP_ENABLED=true

# 可选：Anthropic Claude 或 Anthropic 兼容网关
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# 兼容网关（例如 OpenCode Go）：
# AI_GATEWAY_BASE_URL=https://opencode.ai/inference/go/anthropic
# AI_GATEWAY_MODEL=deepseek-v4.1-flash
# AI_GATEWAY_API_KEY=
# 留空自动生成裸 UUID；手工设置请使用 UUID，不要加业务前缀
# AI_GATEWAY_SESSION_ID=
